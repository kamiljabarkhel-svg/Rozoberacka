# Skopírujte tento súbor ako .env.local a doplňte hodnoty zo Supabase
# (Project Settings → API). Bez nich beží web v ukážkovom režime.
# Do prehliadača ide len verejný "anon" kľúč. Service role kľúč sem NIKDY nedávajte.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Verejná adresa webu po kúpe domény (mapa webu, odkazy pre Google), napr. https://rozoberacka.sk
NEXT_PUBLIC_SITE_URL=
# 1 = zobraziť „Posielať nové diely e-mailom“ (až keď beží Brevo a funkcia supabase/functions/strazca)
NEXT_PUBLIC_EMAIL_ALERTS=
